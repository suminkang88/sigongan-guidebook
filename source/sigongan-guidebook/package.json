{
  "name": "sigongan-accessibility-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 0.0.0.0",
    "check": "node scripts/validate-content.mjs && node scripts/astro.mjs check",
    "build": "npm run check && node scripts/astro.mjs build && node scripts/build-search-index.mjs",
    "preview": "node scripts/astro.mjs preview --host 0.0.0.0",
    "test": "playwright test",
    "review:package": "node scripts/package-review.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "cheerio": "^1.1.2",
    "typescript": "~5.9.3"
  }
}
