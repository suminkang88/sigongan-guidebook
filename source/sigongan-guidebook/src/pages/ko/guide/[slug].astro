---
import {getCollection,render} from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('guide');return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<GuideLayout meta={entry.data}><Content/></GuideLayout>
